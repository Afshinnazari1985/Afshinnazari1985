function [P_wind, P_hydro, P_load, H_dem, price, T] = load_Narvik_data()
% LOAD_NARVIK_DATA  Load or generate hourly profiles for a representative winter day.
%
% Returns:
%   P_wind  [Tx1] — wind generation [MW]
%   P_hydro [Tx1] — hydro generation [MW]
%   P_load  [Tx1] — electrical load excl. DC [MW]
%   H_dem   [Tx1] — thermal demand [MWth]
%   price   [Tx1] — electricity price [$/MWh]
%   T       scalar — number of hours

T = 24;

fprintf('Loading Narvik data profiles...\n');
fprintf('--------------------------------------------------------------\n');

% %% 1. WIND PROFILE- https://www.renewables.ninja/
% P_wind_nameplate = 32.2;  % MW [Nygårdsfjellet]
% 
% wind_file = 'ninja_wind_68.4500_17.3900_corrected.csv';
% if isfile(wind_file)
%     fprintf('  Wind:  Loading from Renewables.ninja CSV...\n');
%     data_wind = readtable(wind_file, 'HeaderLines', 3);
%     P_wind_hourly = data_wind.electricity;
% 
%     P_jan  = P_wind_hourly(1:744);
%     P_wind = mean(reshape(P_jan, 24, []), 2);
% 
%     fprintf('         Range: %.1f - %.1f MW, daily avg: %.1f MW (CF=%.0f%%)\n', ...
%         min(P_wind), max(P_wind), mean(P_wind), mean(P_wind)/P_wind_nameplate*100);
% else
%     fprintf('  Wind:  [WARNING] CSV not found. Using synthetic profile.\n');
%     winter_CF = [0.52 0.50 0.48 0.45 0.43 0.40 0.38 0.35 ...
%                  0.33 0.30 0.28 0.27 0.28 0.30 0.35 0.40 ...
%                  0.45 0.50 0.55 0.58 0.56 0.52 0.48 0.45]';
%     P_wind = P_wind_nameplate * winter_CF;
% end


% %% 1. WIND PROFILE
% P_wind_nameplate = 32.2;  % MW [Nygårdsfjellet]
% 
% wind_file = 'ninja_wind_68_5039_17_8894_new.csv';   % ← new filename
% if isfile(wind_file)
%     fprintf('  Wind:  Loading from Renewables.ninja CSV...\n');
%     data_wind = readtable(wind_file, 'HeaderLines', 3);
%     P_wind_hourly = data_wind.electricity / 1000;    % ← kW → MW
% 
%     % January average = representative winter day
%     P_jan  = P_wind_hourly(1:744);   % Jan = 31 days × 24 h
%     P_wind = mean(reshape(P_jan, 24, []), 2);
% 
%     fprintf('         Range: %.1f - %.1f MW, daily avg: %.1f MW (CF=%.0f%%)\n', ...
%         min(P_wind), max(P_wind), mean(P_wind), mean(P_wind)/P_wind_nameplate*100);
% else
%     % ... synthetic fallback stays the same
% end

% %% 2. PRICE PROFILE
% price_file = 'NO4_prices_from_chart_image_15min.csv';
% if isfile(price_file)
%     fprintf('  Price: Loading from Nord Pool CSV...\n');
%     data_price = readtable(price_file);
% 
%     if ismember('NO4', data_price.Properties.VariableNames)
%         price_EUR_hourly = data_price.NO4;
%     elseif ismember('Price', data_price.Properties.VariableNames)
%         price_EUR_hourly = data_price.Price;
%     else
%         numcols = varfun(@isnumeric, data_price, 'OutputFormat', 'uniform');
%         numidx  = find(numcols, 1);
%         price_EUR_hourly = data_price{:, numidx};
%     end
% 
%     price_jan = price_EUR_hourly(1:24);
%     price_winter_EUR = mean(reshape(price_jan, 24, []), 2);
%     price = price_winter_EUR * 1.08;  % EUR → USD
% 
%     fprintf('         Range: %.1f - %.1f $/MWh, daily avg: %.1f $/MWh\n', ...
%         min(price), max(price), mean(price));
% else
%     fprintf('  Price: [WARNING] CSV not found. Using synthetic profile.\n');
%     price_EUR = [30 28 25 23 22 25 35 55 65 60 55 50 ...
%                  48 50 55 60 72 80 70 58 48 40 35 32]';
%     price = price_EUR * 1.08;
% end


%% 2. PRICE PROFILE - https://data.nordpoolgroup.com/auction/day-ahead/prices?deliveryDate=2026-02-01&currency=EUR&aggregation=DeliveryPeriod&deliveryAreas=NO4
price_file = 'NO4_prices_from_chart_image_15min.csv';
if isfile(price_file)
    fprintf('  Price: Loading from Nord Pool NO4 CSV (15-min resolution)...\n');
    data_price = readtable(price_file, 'Delimiter', ',', 'ReadVariableNames', false, 'HeaderLines', 1);
    price_15min = data_price{:, 2};  % now guaranteed numeric, second column
price_raw = data_price{:, 2};
if iscell(price_raw)
    price_15min = str2double(price_raw);
else
    price_15min = double(price_raw);
end

    % Average every 4 intervals → hourly prices
    % price_hourly_EUR = mean(reshape(price_15min, 4, []), 1)';  % [24×1]

if length(price_15min) < 96
    price_15min(end+1:96) = price_15min(end);  % repeat last value
elseif length(price_15min) > 96
    price_15min = price_15min(1:96);
end
price_hourly_EUR = mean(reshape(price_15min, 4, []), 1)';
    price = price_hourly_EUR * 1.08;  % EUR → USD

    fprintf('         15-min data: %d intervals → %d hourly values\n', ...
        length(price_15min), length(price));
    fprintf('         Range: %.1f - %.1f $/MWh, daily avg: %.1f $/MWh\n', ...
        min(price), max(price), mean(price));
else
    fprintf('  Price: [WARNING] CSV not found. Using synthetic profile.\n');
    price_EUR = [30 28 25 23 22 25 35 55 65 60 55 50 ...
                 48 50 55 60 72 80 70 58 48 40 35 32]';
    price = price_EUR * 1.08;
end

%% 3. ELECTRICAL LOAD PROFILE
load_file = 'entsoe_NO4_load_2024.csv';
if isfile(load_file)
    fprintf('  Load:  Loading from ENTSO-E CSV...\n');
    data_load = readtable(load_file);

    if ismember('ActualTotalLoad', data_load.Properties.VariableNames)
        load_NO4 = data_load.ActualTotalLoad;
    elseif ismember('Value', data_load.Properties.VariableNames)
        load_NO4 = data_load.Value;
    else
        numcols = varfun(@isnumeric, data_load, 'OutputFormat', 'uniform');
        numidx  = find(numcols, 1);
        load_NO4 = data_load{:, numidx};
    end

    load_jan = load_NO4(1:744);
    load_winter_NO4 = mean(reshape(load_jan, 24, []), 2);
    scale_factor = 0.055;
    P_load = load_winter_NO4 * scale_factor;

    fprintf('         Narvik scaled (×%.3f): %.1f - %.1f MW\n', ...
        scale_factor, min(P_load), max(P_load));
else
    fprintf('  Load:  [WARNING] CSV not found. Using synthetic profile.\n');
    P_load = [22 21 21 21 22 25 30 35 38 40 41 40 ...
              39 38 37 36 38 42 44 43 40 35 28 24]';
end

%% 4. HEAT DEMAND PROFILE
heat_file = 'when2heat_singleindex.csv';
if isfile(heat_file)
    fprintf('  Heat:  Loading from When2Heat CSV...\n');
    data_heat = readtable(heat_file);

    if ismember('NO_heat_demand_total', data_heat.Properties.VariableNames)
        H_norm = data_heat.NO_heat_demand_total;
    elseif ismember('NO_heat_demand_space', data_heat.Properties.VariableNames)
        H_norm = data_heat.NO_heat_demand_space;
    else
        numcols = varfun(@isnumeric, data_heat, 'OutputFormat', 'uniform');
        numidx  = find(numcols, 1);
        H_norm  = data_heat{:, numidx};
    end

    H_jan = H_norm(1:744);
    H_winter_norm = mean(reshape(H_jan, 24, []), 2);
    H_dem = H_winter_norm / max(H_winter_norm) * 20;

    fprintf('         Scaled to Narvik DH: %.1f - %.1f MWth\n', min(H_dem), max(H_dem));
else
    fprintf('  Heat:  [WARNING] CSV not found. Using degree-day profile.\n');
    T_indoor  = 21;
    T_outdoor = [-10 -11 -12 -12 -12 -11 -9 -7 -6 -5 -4 -4 ...
                  -4  -5  -6  -7  -8  -9 -10 -10 -10 -10 -10 -10]';
    H_dem_raw = T_indoor - T_outdoor;
    H_dem = H_dem_raw / max(H_dem_raw) * 20;
end

%% 5. HYDRO GENERATION — FIX #2: Sildvik removed
P_hydro_hakvik   = 9.9;    % MW [Nordkraft, local distribution]
% P_hydro_batsvatn = 30.0;   % MW [local distribution]
P_Sildvik = 63;            % transmission-level plant, exports to national grid
P_hydro_total    = P_hydro_hakvik +P_Sildvik;  % = 39.9 MW

hydro_file = 'entsoe_NO4_hydro_2024.csv';
if isfile(hydro_file)
    fprintf('  Hydro: Loading from ENTSO-E CSV...\n');
    data_hydro = readtable(hydro_file);
    NO4_hydro_capacity = 4000;

    if ismember('HydroReservoir', data_hydro.Properties.VariableNames)
        hydro_NO4 = data_hydro.HydroReservoir;
    elseif ismember('Value', data_hydro.Properties.VariableNames)
        hydro_NO4 = data_hydro.Value;
    else
        numcols = varfun(@isnumeric, data_hydro, 'OutputFormat', 'uniform');
        numidx  = find(numcols, 1);
        hydro_NO4 = data_hydro{:, numidx};
    end

    hydro_jan = hydro_NO4(1:744);
    hydro_winter_NO4 = mean(reshape(hydro_jan, 24, []), 2);
    P_hydro = hydro_winter_NO4 * (P_hydro_total / NO4_hydro_capacity);
else
    fprintf('  Hydro: Using price-responsive dispatch model.\n');
    price_norm    = (price - min(price)) / (max(price) - min(price));
    dispatch_frac = 0.60 + 0.30 * price_norm;  % 60% to 90%
    P_hydro       = dispatch_frac .* P_hydro_total;
end

fprintf('  Hydro: %.1f - %.1f MW (installed: %.1f MW)\n', ...
    min(P_hydro), max(P_hydro), P_hydro_total);

%% Summary
fprintf('--------------------------------------------------------------\n');
fprintf('  PROFILE SUMMARY (representative winter day, T=%d hours):\n', T);
fprintf('  Wind:  %.1f - %.1f MW  (nameplate: %.1f MW, CF≈%.0f%%)\n', ...
    min(P_wind), max(P_wind), P_wind_nameplate, mean(P_wind)/P_wind_nameplate*100);
fprintf('  Hydro: %.1f - %.1f MW  (installed: %.1f MW)\n', ...
    min(P_hydro), max(P_hydro), P_hydro_total);
fprintf('  Load:  %.1f - %.1f MW  (daily: %.0f MWh)\n', ...
    min(P_load), max(P_load), sum(P_load));
fprintf('  Heat:  %.1f - %.1f MWth (daily: %.0f MWhth)\n', ...
    min(H_dem), max(H_dem), sum(H_dem));
fprintf('  Price: %.1f - %.1f $/MWh (avg: %.1f $/MWh)\n', ...
    min(price), max(price), mean(price));
fprintf('--------------------------------------------------------------\n\n');

end
